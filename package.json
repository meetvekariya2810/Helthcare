{
  "name": "bjk-healthcare-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix \"BJK HELTHCARE\"",
    "dev:server": "npm run dev:server --prefix \"BJK HELTHCARE\"",
    "dev:serve": "npm run dev:server --prefix \"BJK HELTHCARE\"",
    "dev:client": "npm run dev:client --prefix \"BJK HELTHCARE\"",
    "build": "npm --prefix \"BJK HELTHCARE/client\" install && npm --prefix \"BJK HELTHCARE/client\" run build",
    "start": "node \"BJK HELTHCARE/server/server.js\"",
    "seed": "npm run seed --prefix \"BJK HELTHCARE/server\"",
    "seed:auth": "npm run seed:auth --prefix \"BJK HELTHCARE/server\"",
    "verify": "npm run verify --prefix \"BJK HELTHCARE/server\"",
    "test:hrms": "npm run test:hrms --prefix \"BJK HELTHCARE/server\"",
    "test:policies": "npm run test:policies --prefix \"BJK HELTHCARE/server\"",
    "test:onboarding": "npm run test:onboarding --prefix \"BJK HELTHCARE/server\"",
    "install:all": "npm install && npm install --prefix \"BJK HELTHCARE/server\" && npm install --prefix \"BJK HELTHCARE/client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.7.2",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
