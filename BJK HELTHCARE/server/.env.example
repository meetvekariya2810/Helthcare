# ==============================================================================
# BJK HEALTHCARE DIGITAL BRAIN — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # development | staging | production
CLIENT_URL=http://localhost:5173

COMPANY_NAME=BJK Healthcare Pvt. Ltd.
APP_NAME=BJK Healthcare Digital Brain
MODULE_NAME=BJK Healthcare Enterprise Platform
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (AZURE FLEXIBLE SERVER READY)
# ------------------------------------------------------------------------------
DATABASE_PROVIDER=postgres
# Local Development Mode: Leave DATABASE_URL empty to use the embedded persistent PGlite PostgreSQL engine
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Staging Configuration Example:
# DATABASE_URL=postgresql://bjk_app:StagingPass123!@psql-bjk-staging.postgres.database.azure.com:5432/bjk_healthcare?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# Azure Production Configuration Example (Through PgBouncer Port 6432):
# DATABASE_URL=postgresql://bjk_app:ProdSecurePass123!@psql-bjk-prod.postgres.database.azure.com:6432/bjk_healthcare?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------------------
# 4. MIGRATION TOOLING ONLY (READ-ONLY SOURCE)
# ------------------------------------------------------------------------------
# Note: Used solely by migration tooling (scripts/migration/*). Never accessed by production runtime.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/bjk_healthcare?retryWrites=true&w=majority&appName=Cluster28
DATABASE_NAME=bjk_healthcare

# ------------------------------------------------------------------------------
# 5. MIGRATION SWITCHES (FOR CONTROL SCRIPTS)
# ------------------------------------------------------------------------------
ATLAS_ACCESS=READ_ONLY
STAGING_MIGRATION=APPROVED
PRODUCTION_CUTOVER=NOT_APPROVED
AZURE_RESOURCE_CREATION=NOT_APPROVED
