# =========================================================
# BJK HEALTHCARE DIGITAL BRAIN - ENVIRONMENT CONFIGURATION
# =========================================================

# --- BACKEND (Node.js / Express Server) ---
# Server listening port
PORT=5000

# Environment mode (development / production)
NODE_ENV=production

# Frontend Client Origin (for CORS security in production)
# Example: https://bjk-healthcare.vercel.app or your custom domain
CLIENT_URL=https://your-frontend-domain.vercel.app

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Cluster -> Connect -> Drivers -> Node.js
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bjk_healthcare?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/bjk_healthcare?retryWrites=true&w=majority

# Database name
DATABASE_NAME=bjk_healthcare

# Server JWT Secret (generate a strong random 64-character string)
JWT_SECRET=your_ultra_secure_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Enterprise Branding
COMPANY_NAME=BJK Healthcare Pvt. Ltd.
APP_NAME=BJK Healthcare Digital Brain
MODULE_NAME=BJK Healthcare Enterprise Platform
LOG_LEVEL=info

# --- FRONTEND (Vite / React Client) ---
# Public backend API endpoint
# For single-port local dev or same-origin proxy, use /api
# For production separate hosting (e.g. Render backend + Vercel frontend), set:
# VITE_API_URL=https://your-backend-api.onrender.com/api
VITE_API_URL=/api
