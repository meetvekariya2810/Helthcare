BJK_Employee_Login_Credentials.xlsx
*credential*.xlsx
*credential*.xls
*credential*.csv
*password*.xlsx
*password*.xls
*password*.csv
*CREDENTIAL*.xlsx
*CREDENTIAL*.xls
*CREDENTIAL*.csv
*PASSWORD*.xlsx
*PASSWORD*.xls
*PASSWORD*.csv

# 2. Uploads Directory
BJK HELTHCARE/server/uploads/**
!BJK HELTHCARE/server/uploads/.gitkeep
uploads/**

# 3. Environment & Local Secrets
.env
.env.*
!.env.example
*.env.local

