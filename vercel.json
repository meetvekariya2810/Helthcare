{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "BJK HELTHCARE/client/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
